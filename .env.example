# ===========================================
# AG Salão de Beleza e Spa — Variáveis de Ambiente
# Copie este ficheiro para ".env.local" e preencha os valores reais.
# NUNCA envie o ".env.local" para o GitHub.
# ===========================================

# Segredo usado para assinar a sessão (JWT) do painel admin.
# Gere um valor aleatório forte, ex: openssl rand -base64 48
AUTH_SECRET=troque-este-valor-por-um-segredo-aleatorio-forte

# Credenciais do administrador usadas APENAS no primeiro seed do banco
# (para criar o utilizador admin inicial). Depois do primeiro login,
# altere a palavra-passe pelo próprio painel em /admin/senha.
ADMIN_EMAIL=agcab4784@gmail.com
ADMIN_PASSWORD=troque-esta-senha-antes-do-deploy

# Caminho do ficheiro da base de dados SQLite (usado em desenvolvimento
# e também funciona em produção fora da Vercel, ex: VPS com disco persistente).
DATABASE_PATH=./data/ag-salao.db

# Token do Vercel Blob Storage — necessário em produção na Vercel para que
# as imagens carregadas no painel fiquem persistentes entre deploys.
# Crie em: Vercel Dashboard > Storage > Create Database > Blob
# Sem esta variável, o upload cai automaticamente para disco local (apenas
# recomendado para desenvolvimento — NÃO é persistente na Vercel).
BLOB_READ_WRITE_TOKEN=

# URL pública do site (usada em metadados SEO / Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
